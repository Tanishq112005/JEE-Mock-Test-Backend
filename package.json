{
  "name": "backend",
  "version": "1.0.0",
  "description": "JEE Mock Test Platform",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:server": "env-cmd -f .env.dev npx ts-node src/server.ts",
    "dev:worker": "env-cmd -f .env.dev npx ts-node src/worker/worker.ts",
    "start:dev": "concurrently \"npm run dev:server\" \"npm run dev:worker\"",
    "build": "tsc",
    "prod:server": "env-cmd -f .env.prod node dist/server.js",
    "prod:worker": "env-cmd -f .env.prod node dist/worker/worker.js",
    "start:prod": "concurrently \"npm run prod:server\" \"npm run prod:worker\"",
    "server": "npx ts-node src/server.ts",
    "worker": "npx ts-node src/worker/worker.ts",
    "start": "concurrently \"npm run server\" \"npm run worker\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@types/amqplib": "^0.10.8",
    "@types/dotenv": "^6.1.1",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.4",
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "env-cmd": "^11.0.0",
    "express": "^5.1.0",
    "format": "^0.2.2",
    "googleapis": "^167.0.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "prisma": "^7.0.1",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "concurrently": "^9.2.1"
  }
}
