{
  "name": "backend",
  "version": "1.0.0",
  "description": "JEE Mock Test Platform",
  "license": "ISC",
  "author": "Tanishq Jain",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "prisma": "npx prisma generate",
    "start:prod": "node dist/server.js",
    "start:prod:worker:email": "node dist/worker/emailWorker.js",
    "start:prod:worker:update": "node dist/worker/updateTestDetailsWorker.js",
    "start:prod:worker:watchdog": "node dist/worker/watchdogWorker.js",
    "start:prod:worker:testEvalution": "node dist/worker/testEvalutionWorker.js",
    "start:prod:worker:studentAnalytics": "node dist/worker/studentTestAnalyticsWorker.js",
    "dev:api": "npx ts-node src/server.ts",
    "dev:worker:email": "npx ts-node src/worker/emailWorker.ts",
    "dev:worker:update": "npx ts-node src/worker/updateTestDetailsWorker.ts",
    "dev:worker:watchdog": "npx ts-node src/worker/watchdogWorker.ts",
    "dev:worker:testEvalution": "npx ts-node src/worker/testEvalutionWorker.ts",
    "dev:worker:studentAnalytics": "npx ts-node src/worker/studentTestAnalyticsWorker.ts",
    "start": "concurrently \"npm run dev:api\" \"npm run dev:worker:email\" \"npm run dev:worker:update\" \"npm run dev:worker:watchdog\" \"npm run dev:worker:testEvalution\" \"npm run dev:worker:studentAnalytics\" --names \"API,EMAIL,UPDATE,WATCH,EVAL,ANALYTICS\" --prefix-colors \"blue,magenta,yellow,green,cyan,red\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/node-http-handler": "^3.370.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@google/genai": "^1.34.0",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/axios": "^0.9.36",
    "@types/backblaze-b2": "^1.5.6",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.4",
    "@types/sharp": "^0.31.1",
    "@types/turndown": "^5.0.6",
    "amqplib": "^0.10.9",
    "axios": "^1.13.2",
    "backblaze-b2": "^1.7.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.1.2",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "format": "^0.2.2",
    "googleapis": "^167.0.0",
    "https": "^1.0.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "ollama": "^0.6.3",
    "pg": "^8.16.3",
    "prisma": "^7.0.1",
    "redis": "^5.10.0",
    "sharp": "^0.34.5",
    "string-similarity": "^4.0.4",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
