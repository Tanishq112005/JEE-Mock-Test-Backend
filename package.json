    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@types/string-similarity": "^4.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
