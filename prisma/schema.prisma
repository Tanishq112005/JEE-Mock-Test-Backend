// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// defing the prisma  schema of the database 

enum Day {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum Month {
  January
  February
  March
  April
  May
  June
  July
  August
  September
  October
  November
  December
}

enum ExamName {
  JEE_MAIN
  JEE_ADVANCED
}

enum SubjectName {
  Physics
  Chemistry
  Mathematics
}

enum Study_mode {
  online
  offline
  self
}

enum UserType {
  Student
  Developer
}

enum AttemptStatus {
  ATTEMPTING
  CORRECT
  WRONG
}

enum Shift {
  Morning
  Evening
  Paper_1
  Paper_2
}

enum ExamMode {
  online
  offline
}

enum questionType {
  SingleCorrect
  MultiCorrect
  Integer
  Comprehension
}

// user model table 
model user {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  type            UserType         @default(Student)
  password        String           @unique
  refersh_token   String?          @unique
  created_at      DateTime         @default(now())
  is_verified     Boolean
  student_profile student_profile?
  testSession     testResults[]
}

// user_details table
model student_profile {
  id                 String      @id @default(uuid())
  user_id            String      @unique
  class              Int
  study_mode         Study_mode?
  institution        String?
  phone              BigInt?     @unique
  phone_country_code String?
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt
  user               user        @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// exam model table 
model exam {
  id     String   @id @default(uuid())
  name   ExamName @unique
  papers papers[]
}

// subjects model table 
model subjects {
  id       String      @id @default(uuid())
  name     SubjectName @unique
  chapters chapters[]
  question questions[]
}

// chapters model table 
model chapters {
  id            String      @id @default(uuid())
  name          String      @unique
  subjectId     String
  chapterNumber Int
  class         Int

  // --- New Syllabus Fields ---
  isCbse        Boolean     @default(false)
  isJeeMain     Boolean     @default(false)
  isJeeAdvanced Boolean     @default(false)

  questions     questions[]
  subjects      subjects    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

// papers model table 
model papers {
  id                String      @id @default(uuid())
  examId            String
  year              Int?
  day               Day?
  month             Month?
  date              String?
  shift             Shift?
  mode              ExamMode
  totalMarks        Int?         @default(0)
  totalDuration     Int?         @default(0)
  totalQuestions    Int?         @default(0)
  totalSingleChoice Int?         @default(0)
  totalMultiChoice  Int?         @default(0)
  totalInteger      Int?         @default(0)
  exam              exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions         questions[]

  testSession testResults[]

  @@unique([examId, year, shift])
}

// model questions table 
model questions {
  id                   String       @id @default(uuid())
  paperId              String?
  subjectId            String
  chapterId            String?
  class                Int
  content              String
  comprehensionContent String?
  comprehensionImage   String[]
  image                String[]
  type                 questionType
  positiveMarks        Int
  negativeMarks        Int
  isOutOfSyllabus      Boolean
  isBonus              Boolean
  correctAnswer        String[]
  options              options?
  solution             solution?
  papers               papers?      @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chapters             chapters?    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  subjects             subjects     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  statusOfQuestion QuestionAttempt[]
}

// model options table 
model options {
  id         String @id @default(uuid())
  questionId String @unique

  optionAtext  String?
  optionAimage String[]

  optionBtext  String?
  optionBimage String[]

  optionCtext  String?
  optionCimage String[]

  optionDtext  String?
  optionDimage String[]

  questions questions @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// model solution table
model solution {
  id         String @id @default(uuid())
  questionId String @unique

  text     String
  videoUrl String?
  image    String[]

  question questions @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// model testResults  table 
model testResults {
  id            String   @id @default(uuid())
  paperId       String
  userId        String
  PositiveMarks Int
  NegativeMarks Int
  totalAttempt  Int
  created_at    DateTime @default(now())
  user          user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  papers        papers   @relation(fields: [paperId], references: [id], onDelete: Cascade)
}

// model QuestionAttempt table 
model QuestionAttempt {
  id         String        @id @default(uuid())
  questionId String
  status     AttemptStatus
  userAnswer String[]
  questions  questions     @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
